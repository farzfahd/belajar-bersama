{
    "name":  "belajar-bersama",
    "private":  true,
    "version":  "0.1.0",
    "type":  "module",
    "description":  "Ekosistem belajar privat untuk dua orang - Fase 1 (Spark plan)",
    "scripts":  {
                    "dev":  "vite --host 127.0.0.1",
                    "build":  "vite build",
                    "postbuild":  "node scripts/copy-404.mjs",
                    "preview":  "vite preview",
                    "icons:gallery":  "node scripts/gen-icon-gallery.mjs",
                    "test:rules":  "firebase emulators:exec --only firestore --project demo-learning-berdua \"node tests/firestore.rules.test.js\"",
                    "test:config":  "node --test tests/navigation.test.mjs",
                    "test:progress":  "node --test tests/progress.test.mjs",
                    "test:visibility":  "node --test tests/visibility.test.mjs",
                    "test:topics":  "node --test tests/topics.test.mjs",
                    "test:quiz":  "node --test tests/quiz.test.mjs",
                    "test:quiz-editor":  "node --test tests/quiz-editor-state.test.mjs",
                    "test:question-types":  "node --test tests/question-types.test.mjs",
                    "test:units":  "node --test tests/navigation.test.mjs tests/progress.test.mjs tests/visibility.test.mjs tests/topics.test.mjs tests/grading.test.mjs tests/attempt-engine.test.mjs tests/question-card.test.mjs tests/quiz-editor-state.test.mjs tests/invite.test.mjs tests/leave.test.mjs tests/quiz.test.mjs tests/question-types.test.mjs tests/question-report.test.mjs tests/matching-pairs.test.mjs tests/ordering-answer.test.mjs tests/key-split.test.mjs tests/key-revision.test.mjs tests/snapshot-v3.test.mjs tests/attempt-v3.test.mjs tests/key-view.test.mjs tests/grading-parity.test.mjs tests/ui-guard.test.mjs tests/theme-contrast.test.mjs",
                    "test:attempt":  "node --test tests/attempt-engine.test.mjs",
                    "test:invite":  "node --test tests/invite.test.mjs",
                    "test:leave":  "node --test tests/leave.test.mjs",
                    "test:privacy:e2e":  "node tests/privacy-e2e.mjs",
                    "test:layout":  "node tests/layout-align.mjs",
                    "test:deploy":  "node tests/deploy-config-check.mjs",
                    "test:filter":  "node tests/filter-panel-check.mjs",
                    "test:privacy:accounts":  "node tests/privacy-two-account-probe.mjs",
                    "test:cleanup":  "node tests/helpers/cleanup-test-data.mjs",
                    "emulators":  "firebase emulators:start --import .firebase/emulator-export --export-on-exit",
                    "test:question-report":  "node --test tests/question-report.test.mjs"
                },
    "dependencies":  {
                         "dompurify":  "^3.1.7",
                         "firebase":  "^10.14.1",
                         "fuse.js":  "^7.0.0",
                         "katex":  "^0.16.11",
                         "marked":  "^12.0.2",
                         "react":  "^18.3.1",
                         "react-dom":  "^18.3.1",
                         "react-router-dom":  "^6.26.2"
                     },
    "devDependencies":  {
                            "@firebase/rules-unit-testing":  "^3.0.4",
                            "@vitejs/plugin-react":  "^4.3.3",
                            "autoprefixer":  "^10.4.20",
                            "firebase-tools":  "^13.30.0",
                            "postcss":  "^8.4.47",
                            "tailwindcss":  "^3.4.14",
                            "vite":  "^5.4.10"
                        }
}
