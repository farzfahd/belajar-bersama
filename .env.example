# ===== Firebase (wajib diisi) =====
# Semua nilai VITE_* adalah PUBLIC dan ikut terbundle. Jangan taruh secret lain di frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional tapi disarankan
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ===== App Check reCAPTCHA Enterprise / Google Cloud Fraud Defense =====
# Kosongkan untuk memakai App Check dengan debug token emulator saja.
VITE_RECAPTCHA_SITE_KEY=

# Khusus development lokal dari terminal, JANGAN di-commit.
# Isi sama dengan token yang muncul di log console waktu App Check error di localhost.
VITE_APPCHECK_DEBUG_TOKEN=

# ===== Mode emulator (development lokal) =====
# Set "true" untuk pakai Auth + Firestore emulator lokal (http://127.0.0.1:9099 dan :8080).
# Tempatkan di `.env.development.local` (sudah di .gitignore). JANGAN diisi di .env produksi.
# Jalankan terminal terpisah: `firebase emulators:start` lalu `npm run dev`.
VITE_USE_EMULATORS=
