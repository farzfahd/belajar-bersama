# ===== Firebase (wajib diisi) =====
# Semua nilai VITE_* adalah PUBLIC dan ikut terbundle. Jangan taruh secret lain di frontend.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Optional tapi disarankan
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_STORAGE_BUCKET=

# ===== App Check =====
# Produksi memakai reCAPTCHA Enterprise (Google Cloud Fraud Defense) —
# reCAPTCHA v3 TIDAK dipakai project ini. Jangan buat key v3 baru.
VITE_RECAPTCHA_SITE_KEY=

# Provider App Check. Nilai produksi WAJIB "enterprise".
# "enterprise" → ReCaptchaEnterpriseProvider (dipakai produksi)
# "v3"         → ReCaptchaV3Provider, hanya escape hatch dev, bukan produksi
#               (memunculkan peringatan di console; JANGAN dipakai di produksi)
# Kalau kosong/tidak dikenal, kode jatuh ke "enterprise" — bukan ke v3.
VITE_RECAPTCHA_PROVIDER=enterprise

# Token debug App Check — KHUSUS development lokal dari browser, JANGAN di-commit.
# Ambil dari Firebase Console > App Check > Apps > REGISTER NEW DEBUG TOKEN
# (untuk domain http://localhost:5173 dan http://127.0.0.1:5173).
# Taruh nilainya di `.env.development.local` (sudah di .gitignore).
# Isi "true" hanya untuk memakai token acak yang dicetak di console —
# HINDARI di produksi, token bisa ditebak siapa saja.
VITE_APPCHECK_DEBUG_TOKEN=

# Opsional: GitHub Pages project site memakai nama repository sebagai base path.
# Dipakai DUA tempat sekaligus: `base` Vite (path aset di index.html) dan
# `basename` BrowserRouter. Set "/nama-repo" (tanpa garis miring di akhir).
# Contoh: /belajar-bersama. Kosongkan untuk localhost atau Firebase Hosting root.
VITE_ROUTER_BASENAME=

# ===== Mode emulator (development lokal) =====
# Set "true" untuk pakai Auth + Firestore emulator lokal (http://127.0.0.1:9099 dan :8080).
# Tempatkan di `.env.development.local` (sudah di .gitignore). JANGAN diisi di .env produksi.
# Jalankan terminal terpisah: `firebase emulators:start` lalu `npm run dev`.
VITE_USE_EMULATORS=
